# Copy this file to .env and fill in real values. .env is ignored by git.
# Real environment variables always win over values in this file.

# MySQL DSN (go-sql-driver/mysql format). The server refuses to start while
# the password is still the placeholder.
DATABASE_DSN=root:YOUR_PASSWORD_HERE@tcp(127.0.0.1:3306)/ledger?parseTime=true&multiStatements=true

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# debug, info, warn or error / json or text
LOG_LEVEL=info
LOG_FORMAT=text

# Time zone that decides which calendar day "today" is.
BUSINESS_TIMEZONE=Asia/Jakarta

# Currencies whose system accounts are created on startup.
CURRENCIES=IDR,USD

# Apply migrations and seed the chart of accounts when the server starts.
MIGRATE_ON_START=true
SEED_CHART=true

# How often the background job expires due holds (0s disables it).
HOLD_EXPIRY_INTERVAL=30s

SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=1048576

# Used only by `make test-integration`. The database name must end with _test.
# TEST_DATABASE_DSN=root:YOUR_PASSWORD_HERE@tcp(127.0.0.1:3306)/ledger_test
